## Citation year is PINNED to the first-release year (CRAN 2021-11-03).
## DESCRIPTION has no Date field, so deriving it from meta$Date yielded an
## empty year, and a current-date fallback made the same package version
## cite as a different year every calendar year. Keep this in sync with the
## bibtex block in README.md.
year <- 2021
note <- sprintf("R package version %s", meta$Version)

bibentry(
  bibtype     = "Misc",
  header      = "To cite the wehoop R package in publications, use:",
  title       = "wehoop: The SportsDataverse's R Package for Women's Basketball Data.",
  author      = c(
    person("Saiem", "Gilani", comment = c(ORCID = "0000-0002-7194-9067")),
    person("Geoff", "Hutchinson")
  ),
  url         = "https://doi.org/10.32614/CRAN.package.wehoop",
  doi         = "10.32614/cran.package.wehoop",
  journal     = "CRAN: Contributed Packages",
  publisher   = "The R Foundation",
  year        = year,
  note        = note,
  textVersion = paste(
    "Saiem Gilani and Geoff Hutchinson.",
    "wehoop: The SportsDataverse's R Package for Women's Basketball Data.",
    "Retrieved from https://doi.org/10.32614/CRAN.package.wehoop"
  )
)
